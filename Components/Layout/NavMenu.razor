@implements IDisposable
@inject CarritoState Carrito
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Final_Edi3</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="catalogo">
                <span class="bi bi-music-note-beamed" aria-hidden="true"></span> Catálogo
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="carrito">
                <span class="bi bi-cart" aria-hidden="true"></span> Carrito
                @if (Carrito.CantidadTotal > 0)
                {
                    <span class="badge bg-warning text-dark ms-1">@Carrito.CantidadTotal</span>
                }
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="admin/productos">
                <span class="bi bi-gear" aria-hidden="true"></span> Administrar
            </NavLink>
        </div>
    </nav>
</div>
@code {
    protected override void OnInitialized()
        => Carrito.OnChange += AlCambiarCarrito;

    private void AlCambiarCarrito()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Carrito.OnChange -= AlCambiarCarrito;
}
