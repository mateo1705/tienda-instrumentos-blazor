@page "/admin/productos"
@inject IProductoService ProductoService
@inject CarritoState Carrito

<PageTitle>Administrar productos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Administrar productos</h1>
    <a href="admin/nuevo-producto" class="btn btn-success">
        <i class="bi bi-plus-lg" aria-hidden="true"></i> Nuevo producto
    </a>
</div>

<form class="row g-2 mb-3" role="search" @onsubmit="BuscarAsync">
    <div class="col-9 col-md-6">
        <label for="busqueda" class="visually-hidden">Buscar por nombre o marca</label>
        <input id="busqueda" class="form-control" placeholder="Buscar por nombre o marca"
               @bind="busqueda" @bind:event="oninput" />
    </div>
    <div class="col-3 col-md-2 d-grid">
        <button type="submit" class="btn btn-primary">Buscar</button>
    </div>
</form>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert alert-success" role="status" aria-live="polite">@mensaje</div>
}

@if (mensajeError is not null)
{
    <AlertError Mensaje="@mensajeError" OnCerrar="() => mensajeError = null" />
}

@if (isLoading)
{
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Cargando...</span>
    </div>
}
else if (resultado.Items.Count == 0 && mensajeError is null)
{
    <p class="text-muted">No hay productos que coincidan con la búsqueda.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Nombre</th>
                    <th scope="col">Categoría</th>
                    <th scope="col">Precio</th>
                    <th scope="col">Stock</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in resultado.Items)
                {
                    <tr>
                        <td>@p.Nombre <small class="text-muted">(@p.Marca)</small></td>
                        <td>@p.Categoria?.Nombre</td>
                        <td>$@p.Precio.ToString("N0")</td>
                        <td>@p.Stock</td>
                        <td class="text-end">
                            <a href="admin/editar-producto/@p.Id" class="btn btn-outline-primary btn-sm">Editar</a>
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => PedirEliminar(p)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <Paginacion PaginaActual="pagina"
                TotalPaginas="resultado.TotalPaginas"
                OnCambio="CambiarPagina" />
}

<ConfirmarModal Visible="aEliminar is not null"
                Titulo="Eliminar producto"
                TextoConfirmar="Sí, eliminar"
                OnConfirmar="ConfirmarEliminar"
                OnCancelar="CancelarEliminar">
    ¿Seguro que querés eliminar <strong>@aEliminar?.Nombre</strong>? Esta acción no se puede deshacer.
</ConfirmarModal>

@code {
    private const int TamanioPagina = 8;

    private PagedResult<ProductoEntity> resultado = new();
    private string busqueda = string.Empty;
    private int pagina = 1;
    private bool isLoading = true;
    private ProductoEntity? aEliminar;
    private string? mensaje;
    private string? mensajeError;

    protected override async Task OnInitializedAsync()
        => await CargarAsync();

    private async Task CargarAsync()
    {
        isLoading = true;
        try
        {
            resultado = await ProductoService.ObtenerPaginado(pagina, TamanioPagina, busqueda);
        }
        catch (Exception)
        {
            mensajeError = "No se pudieron cargar los productos.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task BuscarAsync()
    {
        pagina = 1;
        await CargarAsync();
    }

    private async Task CambiarPagina(int nueva)
    {
        pagina = nueva;
        await CargarAsync();
    }

    private void PedirEliminar(ProductoEntity p) => aEliminar = p;

    private void CancelarEliminar() => aEliminar = null;

    private async Task ConfirmarEliminar()
    {
        if (aEliminar is null) return;

        var producto = aEliminar;
        aEliminar = null;
        mensajeError = null;

        try
        {
            await ProductoService.Eliminar(producto.Id);
            Carrito.Quitar(producto.Id);   // también se saca del carrito
            mensaje = $"Se eliminó \"{producto.Nombre}\".";

            await CargarAsync();

            // Si se vació la última página, volver a la anterior
            if (resultado.Items.Count == 0 && pagina > 1)
            {
                pagina--;
                await CargarAsync();
            }
        }
        catch (Exception)
        {
            mensajeError = "No se pudo eliminar el producto.";
        }
    }
}