@if (TotalPaginas > 1)
{
    <nav aria-label="Paginación de productos">
        <ul class="pagination justify-content-center">
            <li class="page-item @(PaginaActual <= 1 ? "disabled" : "")">
                <button class="page-link" disabled="@(PaginaActual <= 1)"
                        @onclick="() => Ir(PaginaActual - 1)">
                    Anterior
                </button>
            </li>

            @for (var i = 1; i <= TotalPaginas; i++)
            {
                var n = i;
                <li class="page-item @(n == PaginaActual ? "active" : "")">
                    <button class="page-link"
                            aria-current="@(n == PaginaActual ? "page" : null)"
                            @onclick="() => Ir(n)">
                        @n
                    </button>
                </li>
            }

            <li class="page-item @(PaginaActual >= TotalPaginas ? "disabled" : "")">
                <button class="page-link" disabled="@(PaginaActual >= TotalPaginas)"
                        @onclick="() => Ir(PaginaActual + 1)">
                    Siguiente
                </button>
            </li>
        </ul>
    </nav>
}

@code {
    [Parameter] public int PaginaActual { get; set; } = 1;
    [Parameter] public int TotalPaginas { get; set; }
    [Parameter] public EventCallback<int> OnCambio { get; set; }

    private async Task Ir(int numero)
    {
        if (numero >= 1 && numero <= TotalPaginas && numero != PaginaActual)
            await OnCambio.InvokeAsync(numero);
    }
}